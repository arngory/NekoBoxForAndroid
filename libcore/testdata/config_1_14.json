    "type": "local",
    "tag": "dns-local"
   },
   {
    "type": "https",
    "tag": "dns-direct",
    "server": "dns.alidns.com",
    "path": "/dns-query",
    "domain_resolver": {
     "server": "dns-local",
     "strategy": "ipv4_only"
    }
   },
   {
    "type": "tls",
    "tag": "dns-remote",
    "server": "dns.google",
    "detour": "proxy",
    "domain_resolver": {
     "server": "dns-direct",
     "strategy": "ipv4_only"
    }
   },
   {
    "type": "fakeip",
    "tag": "dns-fake",
    "inet4_range": "198.18.0.0/15",
    "inet6_range": "fc00::/18"
   }
  ],
  "rules": [
   {
    "domain": [
     "vless.example.com"
    ],
    "server": "dns-direct",
    "strategy": "prefer_ipv4"
   },
   {
    "domain_suffix": [
     "ads.example"
    ],
    "action": "predefined",
    "rcode": "NOERROR"
   },
   {
    "inbound": [
     "tun-in"
    ],
    "server": "dns-fake",
    "disable_cache": true,
    "strategy": "ipv4_only"
   },
   {
    "rule_set": [
     "rule-set:https://example.com/geosite-ru-blocked.srs"
    ],
    "server": "dns-remote"
   }
  ],
  "final": "dns-remote",
  "strategy": "prefer_ipv4",
  "optimistic": true
 },
