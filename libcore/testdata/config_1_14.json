 "route": {
  "auto_detect_interface": true,
  "default_domain_resolver": {
   "server": "dns-direct",
   "strategy": "ipv4_only"
  },
  "final": "proxy",
  "rules": [
   {
    "inbound": [
     "tun-in",
     "mixed-in"
    ],
    "action": "sniff"
   },
   {
    "port": [
     53
    ],
    "action": "hijack-dns"
   },
   {
    "protocol": [
     "dns"
    ],
    "action": "hijack-dns"
   },
   {
    "inbound": [
     "tun-in",
     "mixed-in"
    ],
    "action": "resolve",
    "strategy": "prefer_ipv4"
   },
   {
    "inbound": [
     "tun-in",
     "mixed-in"
    ],
    "network": [
     "udp"
    ],
    "action": "resolve",
    "strategy": "prefer_ipv4"
   },
   {
    "domain_suffix": [
     "ads.example"
    ],
    "action": "reject"
   },
   {
    "ip_is_private": true,
    "outbound": "bypass"
   },
   {
    "domain_suffix": [
     "youtube.com"
    ],
    "outbound": "bypass",
    "tls_record_fragment": true
   },
   {
    "rule_set": [
     "rule-set:https://example.com/geosite-ru-blocked.srs"
    ],
    "outbound": "proxy"
   }
  ],
  "rule_set": [
   {
    "type": "remote",
    "tag": "rule-set:https://example.com/geosite-ru-blocked.srs",
    "format": "binary",
    "url": "https://example.com/geosite-ru-blocked.srs",
    "update_interval": "24h"
   }
  ]
 },
 "experimental": {
  "cache_file": {
   "enabled": true,
   "path": "cache.db"
  }
 }
}
