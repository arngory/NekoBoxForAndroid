<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <TextView
            style="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tls_fragment" />

        <RadioGroup
            android:id="@+id/tls_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/tls_fragment_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/off" />

            <RadioButton
                android:id="@+id/tls_fragment_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tls_fragment_record" />

            <RadioButton
                android:id="@+id/tls_fragment_tcp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tls_fragment_tcp" />
        </RadioGroup>

        <TextView
            style="?android:attr/textAppearanceSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/tls_fragment_summary"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            style="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cert_pins" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cert_pins_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cert_pins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textMultiLine|textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="?android:attr/textAppearanceSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/cert_pins_summary"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            style="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_tunnel" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dns_tunnel_resolver">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dns_tunnel_resolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textUri|textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dns_tunnel_domain">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dns_tunnel_domain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textUri|textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dns_tunnel_key">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dns_tunnel_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="text|textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="?android:attr/textAppearanceSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/dns_tunnel_summary"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            style="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/port_knocking" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/port_knocking_sequence">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/knock_sequence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textMultiLine|textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/port_knocking_interval">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/knock_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/port_knocking_ttl">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/knock_ttl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/port_knocking_silence">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/knock_silence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="?android:attr/textAppearanceSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/port_knocking_summary"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</ScrollView>
